# Control-plane image for Fly.
#
# Runs the multi-tenant orchestrator that spawns tenant Fly Machines
# via the Machines API. apps/api calls this over the private 6PN
# network (CONTROL_PLANE_INTERNAL_URL=http://daemora-control-plane.flycast:8080).
#
# Required env (set via flyctl secrets):
#   FLY_API_TOKEN          — org-level token; can create machines in tenant app
#   FLY_TENANT_APP_NAME    — e.g. "daemora-tenants"
#   FLY_REGION             — e.g. "iad"
#   FLY_TENANT_IMAGE       — e.g. "registry.fly.io/daemora-tenants:tenant"
#   CONTROL_PLANE_ADMIN_TOKEN
#   MASTER_KEK
#   DAEMORA_RUNTIME        — set to "fly" (defaults to "local" without)

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -d /app -s /bin/false app

# tsx for running TS directly (matches apps/api pattern).
RUN npm i -g tsx@^4.19.2 --ignore-scripts

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src

ENV NODE_ENV=production
ENV CONTROL_PLANE_PORT=8080
ENV DAEMORA_DATA_DIR=/app/data
ENV DAEMORA_RUNTIME=fly

RUN mkdir -p /app/data && chown -R app:app /app
USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:8080/health" >/dev/null 2>&1 || exit 1

CMD ["tsx", "src/cli/index.ts", "control-plane", "start"]
