# apps/api — env template (LOCAL DEV ONLY).
#
#   cp apps/api/.env.example apps/api/.env.local   # then fill secrets below
#
# This file is loaded by `node --env-file=apps/api/.env.local …` for local dev.
# In PRODUCTION on Fly.io, these values come from:
#   - apps/api/fly.toml [env] block (non-secret runtime URLs, log level, etc.)
#   - `flyctl secrets set …`        (DATABASE_URL, JWT_SIGNING_KEY, RESEND_API_KEY, etc.)
# NOTHING in this file is read in prod. Don't put real prod values here.

# ═════════════════════════════════════════════════════════════════════
#  SECRETS — generate fresh values, NEVER commit real ones
# ═════════════════════════════════════════════════════════════════════

# Postgres (Neon free tier works). Quote when URL contains '&'.
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Auth + crypto — generate each with:  openssl rand -base64 32
JWT_SIGNING_KEY=
SESSION_COOKIE_SECRET=
MASTER_KEK=

# apps/api → control plane (inter-service). Generate:  openssl rand -hex 24
CONTROL_PLANE_ADMIN_TOKEN=

# Resend — unset in dev → emails captured in-memory + logged to stdout.
# In prod (Fly), set via:  flyctl secrets set RESEND_API_KEY=re_xxx
RESEND_API_KEY=

# ═════════════════════════════════════════════════════════════════════
#  LOCAL DEV DEFAULTS — these localhost URLs are correct for dev only.
#  In prod, fly.toml supplies the public URLs.
# ═════════════════════════════════════════════════════════════════════

PUBLIC_APP_URL=http://localhost:5173       # UI dev server (Vite)
PUBLIC_API_URL=http://localhost:8090       # this API's URL (links in verify/magic-link emails)
CONTROL_PLANE_INTERNAL_URL=http://localhost:8080
RESEND_FROM_EMAIL=no-reply@daemora.com
TENANT_HOST_SUFFIX=.daemora.app
CONTRA_PAYMENT_LINK_LITE=
CONTRA_PAYMENT_LINK_PRO=https://contra.com/payment-link/aWzV57XT-daemora-research

NODE_ENV=development
LOG_LEVEL=info
PORT=8090

# Used only if you run the control plane on the same machine for full local testing.
DAEMORA_DATA_DIR=./data/cloud-tenants
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_HOST_SUFFIX=.localhost
