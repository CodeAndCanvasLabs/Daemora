# apps/api — environment template.
# Copy to .env.local for dev:  cp apps/api/.env.example apps/api/.env.local
# For Fly.io: set these as Fly secrets, NOT in fly.toml:
#   flyctl secrets set DATABASE_URL="..." JWT_SIGNING_KEY="..." (etc)

# ── Postgres (Neon or any postgres URL) ──────────────────────────────
# Quote the value if it contains '&' (channel_binding etc).
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# ── Auth + crypto (generate with: openssl rand -base64 32) ───────────
JWT_SIGNING_KEY=
SESSION_COOKIE_SECRET=
MASTER_KEK=

# ── Inter-service (apps/api → control plane) ─────────────────────────
CONTROL_PLANE_INTERNAL_URL=http://localhost:8080
# Generate with: openssl rand -hex 24
CONTROL_PLANE_ADMIN_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────
# Leave RESEND_API_KEY unset in dev → emails captured in-memory.
# In prod, verify your sending domain at resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@daemora.com

# ── Billing (Contra payment links per plan) ──────────────────────────
CONTRA_PAYMENT_LINK_LITE=
CONTRA_PAYMENT_LINK_PRO=https://contra.com/payment-link/aWzV57XT-daemora-research

# ── Public URLs ──────────────────────────────────────────────────────
# UI origin (CORS + post-auth redirect target)
PUBLIC_APP_URL=http://localhost:5173
# This API's public origin (Better Auth baseURL → email links point here)
PUBLIC_API_URL=http://localhost:8090
TENANT_HOST_SUFFIX=.daemora.app

# ── Operational ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8090

# ── Control plane (only when running it alongside apps/api locally) ──
DAEMORA_DATA_DIR=./data/cloud-tenants
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_HOST_SUFFIX=.localhost
