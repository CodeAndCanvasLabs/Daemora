<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Daemora</title>
    <organization>com.codeandcanvaslabs</organization>
    <domains enable_localSystem="false" enable_currentUserHome="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="false" hostArchitectures="x86_64,arm64"/>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <license    file="license.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.codeandcanvaslabs.daemora"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="com.codeandcanvaslabs.daemora" visible="false">
        <pkg-ref id="com.codeandcanvaslabs.daemora"/>
    </choice>

    <pkg-ref id="com.codeandcanvaslabs.daemora"
             version="1.0.0"
             onConclusion="none">Daemora-component.pkg</pkg-ref>
</installer-gui-script>
