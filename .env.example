# Copy this file to `.env` and fill in what you need.
# `.env` is git-ignored.

# Optional: auto-unlock the vault on container start so the agent can
# read API keys without anyone opening the UI. Leave blank to require
# a manual unlock from the Settings page after each restart.
DAEMORA_VAULT_PASSPHRASE=

# Optional: Vertex AI Service Account auth. Set both to enable Claude on
# Vertex (partner models — needs a Marketplace subscription on the GCP
# project) and Veo video generation. Leave blank to fall back to the
# Express (API-key) path, which only covers Gemini GA models.
DAEMORA_VERTEX_SA_KEY_PATH=
DAEMORA_VERTEX_PROJECT_ID=
# Optional location overrides. Defaults: location=us-central1 (Veo),
# anthropic_location=global, gemini_location=global. Override for Claude
# 3.x ids (use us-east5) if global 404s.
# DAEMORA_VERTEX_LOCATION=us-central1
# DAEMORA_VERTEX_ANTHROPIC_LOCATION=global
# DAEMORA_VERTEX_GEMINI_LOCATION=global
